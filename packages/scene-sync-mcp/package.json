{
  "name": "@afjk/scene-sync-mcp",
  "version": "0.1.3",
  "description": "MCP server for afjk.jp Scene Sync",
  "type": "module",
  "bin": {
    "scene-sync-mcp": "./bin/scene-sync-mcp.js",
    "scene-sync-mcp-setup": "./bin/scene-sync-mcp-setup.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node src/server.mjs",
    "setup:codex": "node src/setup.mjs codex",
    "setup:codex:staging": "node src/setup.mjs codex --staging",
    "setup:claude": "node src/setup.mjs claude",
    "setup:claude:staging": "node src/setup.mjs claude --staging"
  }
}
