[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/scene_sync/scene_sync_dock.gd" id="1"]

[node name="SceneSyncDock" type="VBoxContainer"]
offset_right = 320.0
offset_bottom = 520.0
theme_override_constants/separation = 8
script = ExtResource("1")

[node name="TitleLabel" type="Label" parent="."]
