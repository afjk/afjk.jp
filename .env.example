# Scene Sync Configuration

# GLB upload limit in bytes (default: 524,288,000 = 500 MiB)
SCENE_SYNC_MAX_UPLOAD_BYTES=524288000

# GLB backup driver: 'local' (default) or 's3'
SCENE_SYNC_GLB_BACKUP_DRIVER=local

# S3/Wasabi backup configuration (only needed if driver=s3)
SCENE_SYNC_GLB_BACKUP_S3_ENDPOINT=https://s3.ap-northeast-1.wasabisys.com
SCENE_SYNC_GLB_BACKUP_S3_REGION=ap-northeast-1
SCENE_SYNC_GLB_BACKUP_S3_BUCKET=scene-sync-glb-backup
SCENE_SYNC_GLB_BACKUP_S3_PREFIX=scene-sync/glb-backup
SCENE_SYNC_GLB_BACKUP_S3_ACCESS_KEY_ID=xxxxx
SCENE_SYNC_GLB_BACKUP_S3_SECRET_ACCESS_KEY=xxxxx

# TURN server configuration
TURN_URL=
TURN_USERNAME=pipe
TURN_CREDENTIAL=pipe
